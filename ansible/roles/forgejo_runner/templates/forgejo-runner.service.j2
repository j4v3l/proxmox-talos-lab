[Unit]
Description=Repository-scoped Forgejo Actions runner
After=network-online.target forgejo-runner-podman.service
Requires=forgejo-runner-podman.service
ConditionPathExists=/var/lib/forgejo-runner/.runner

[Service]
Type=simple
User={{ forgejo_runner_user }}
Group={{ forgejo_runner_user }}
Environment=HOME=/var/lib/forgejo-runner
Environment=XDG_RUNTIME_DIR=/run/forgejo-runner
ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo-runner.yaml
Restart=always
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/forgejo-runner /run/forgejo-runner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
