vlan_id          = 80
lab_base_domain  = "lab.home.arpa"

# Set these only after the named gate is genuinely complete.
stopped_pbs_backups_verified      = false
offline_recovery_capture_verified = false
hardware_capacity_verified        = false

cluster_name       = "talos-lab"
cluster_vip        = "192.168.80.10"
talos_version      = "v1.13.3"
kubernetes_version = "v1.35.5"
