proxmox_endpoint  = "https://192.168.0.119:8006/"
proxmox_node_name = "pve"
proxmox_insecure  = false

vm_datastore_id  = "talos-ssd"
iso_datastore_id = "local"
secure_boot_enabled           = true
efi_disk_datastore_id         = "talos-ssd"
secure_boot_pre_enrolled_keys = false
siderolink_enabled            = false
# siderolink_api_url          = "https://<your-omni-siderolink-endpoint>/?jointoken=<token>&grpc_tunnel=true"
